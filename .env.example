# =============================================================================
# Backend
# =============================================================================
DATABASE_URL=postgresql+asyncpg://donghaeng:donghaeng@localhost:5434/donghaeng
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Storage (Cloudflare R2 / S3 compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=donghaeng-media
R2_PUBLIC_URL=https://media.donghaeng.app
# Local dev uses MinIO via docker-compose
S3_ENDPOINT_URL=http://localhost:9000

# OAuth (backend verifies tokens issued by NextAuth)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OCR (영수증) — Phase 3
NAVER_CLOVA_OCR_URL=
NAVER_CLOVA_OCR_SECRET=
GOOGLE_VISION_API_KEY=

# 계좌정보 암호화 (Fernet 32-byte base64 key)
BANK_INFO_ENCRYPTION_KEY=

ENVIRONMENT=development  # development | staging | production
SENTRY_DSN=

# =============================================================================
# Frontend
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
